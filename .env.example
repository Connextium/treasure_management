###############################################################################
### ENVIRONMENT CONFIGURATION TEMPLATE                                      ###
### Copy this file to .env and fill in your values                          ###
### DO NOT COMMIT .env TO VERSION CONTROL                                   ###
###############################################################################

# Ethereum private key (hex format or 1Password reference: op://vault/item/field)
CRE_ETH_PRIVATE_KEY=your_ethereum_private_key_here

# Your Ethereum wallet address
PREDICTOR=0xYourEthereumAddressHere

# Etherscan API Key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Google Gemini API Key for AI features
GEMINI_API_KEY_VAR=your_google_gemini_api_key_here

# CRE Marketplace Contract Address (e.g., deployed on Sepolia)
MARKET_ADDRESS=0xYourMarketplaceContractAddressHere

# Default CRE target environment (e.g., staging-settings, production-settings)
CRE_TARGET=staging-settings

# Keystone Forwarder Contract Address
CRE_KEYSTONE_FORWARDER_ADDRESS=0xYourKeystoneForwarderAddressHere